<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="room_example_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="north_col">
          <pose>0 1.5 0.25 0 0 0</pose>
          <geometry><box><size>3.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="north_vis">
          <pose>0 1.5 0.25 0 0 0</pose>
          <geometry><box><size>3.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>

        <collision name="south_col">
          <pose>0 -1.5 0.25 0 0 0</pose>
          <geometry><box><size>3.1 0.1 0.5</size></box></geometry>
        </collision>
        <visual name="south_vis">
          <pose>0 -1.5 0.25 0 0 0</pose>
          <geometry><box><size>3.1 0.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>

        <collision name="east_col">
          <pose>1.5 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 3.1 0.5</size></box></geometry>
        </collision>
        <visual name="east_vis">
          <pose>1.5 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 3.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>

        <collision name="west_col">
          <pose>-1.5 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 3.1 0.5</size></box></geometry>
        </collision>
        <visual name="west_vis">
          <pose>-1.5 0 0.25 0 0 0</pose>
          <geometry><box><size>0.1 3.1 0.5</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_box">
      <static>true</static>
      <pose>-1.35 0.6 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.1 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_cylinder">
      <static>true</static>
      <pose>0.5 1.35 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.6 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="free_box_a">
      <static>true</static>
      <pose>-0.6 -0.6 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="free_box_b">
      <static>true</static>
      <pose>0.7 -0.5 0.15 0 0 0.785</pose> <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="free_cylinder_a">
      <static>true</static>
      <pose>-0.5 0.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.7 0.5 0.0 1</ambient><diffuse>0.9 0.6 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>