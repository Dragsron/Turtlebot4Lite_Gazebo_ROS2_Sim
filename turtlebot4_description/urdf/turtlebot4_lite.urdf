<?xml version="1.0"?>
<robot name="turtlebot4_lite">

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.17" length="0.10"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.17" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <inertia ixx="0.0322" ixy="0.0" ixz="0.0" iyy="0.0322" iyz="0.0" izz="0.0578"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000067" ixy="0.0" ixz="0.0" iyy="0.000067" iyz="0.0" izz="0.000123"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent>base_link</parent>
    <child>left_wheel</child>
    <origin xyz="0.0 0.115 -0.035" rpy="-1.5708 0 0"/>
    <axis><xyz>0 0 1</xyz></axis> </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.000067" ixy="0.0" ixz="0.0" iyy="0.000067" iyz="0.0" izz="0.000123"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent>base_link</parent>
    <child>right_wheel</child>
    <origin xyz="0.0 -0.115 -0.035" rpy="-1.5708 0 0"/>
    <axis><xyz>0 0 1</xyz></axis> </joint>

  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.000016" ixy="0.0" ixz="0.0" iyy="0.000016" iyz="0.0" izz="0.000016"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent>base_link</parent>
    <child>caster_wheel</child>
    <origin xyz="-0.12 0.0 -0.05" rpy="0 0 0"/>
  </joint>

  <link name="rplidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.000066" ixy="0.0" ixz="0.0" iyy="0.000066" iyz="0.0" izz="0.000092"/>
    </inertial>
  </link>

  <joint name="rplidar_joint" type="fixed">
    <parent>base_link</parent>
    <child>rplidar_link</child>
    <origin xyz="0.03 0.0 0.07" rpy="0 0 0"/>
  </joint>

  <link name="oakd_link">
    <visual>
      <geometry>
        <box size="0.02 0.09 0.02"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.09 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
